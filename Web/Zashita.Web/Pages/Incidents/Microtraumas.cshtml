@page "/Incidents/Microtraumas"
@model Zashita.Web.Pages.Incidents.MicrotraumasModel
@{
    ViewData["Title"] = "Учёт микротравм";
    ViewData["Subtitle"] = Model.Organization;
}

@if (!string.IsNullOrWhiteSpace(Model.Message)) { <p class="form-error">@Model.Message</p> }

<div class="ppe-split">
    <div class="panel ppe-panel ppe-split-side">
        <div class="ppe-toolbar">
            <a class="btn btn-outline" asp-page="/Incidents/Microtraumas" asp-route-create="true">Новая запись</a>
        </div>
        <table class="data-grid">
            <thead><tr><th>Номер</th><th>Пострадавший</th></tr></thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td><a asp-page="/Incidents/Microtraumas" asp-route-editId="@row.Id">@row.Number</a></td>
                        <td>@row.Victims</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="panel ppe-panel ppe-split-main">
        <h2 class="ppe-step-title">Микротравма</h2>
        @if (!string.IsNullOrWhiteSpace(Model.EditId) || Model.Create)
        {
            <form method="post" asp-page-handler="Save">
                <input type="hidden" asp-for="EditId" />
                <label class="ppe-field"><span>Номер</span><input asp-for="Number" class="ppe-input" required /></label>
                <label class="ppe-field"><span>Дата документа</span><input asp-for="DocumentDate" type="date" class="ppe-input" /></label>
                <label class="ppe-field"><span>Дата события</span><input asp-for="EventDateTime" type="datetime-local" class="ppe-input" /></label>
                <label class="ppe-field"><span>Организация</span><input value="@Model.Organization" class="ppe-input" readonly /></label>
                @await Html.PartialAsync("~/Pages/Shared/_DepartmentSelect.cshtml", new Zashita.Web.Pages.Shared.DepartmentSelectModel
                {
                    Name = "Department",
                    Value = Model.Department,
                    Options = Model.Departments,
                    Optional = true
                })
                <label class="ppe-field"><span>Пострадавший</span><input asp-for="Victims" class="ppe-input" required /></label>
                <label class="ppe-field"><span>Часть тела</span><input asp-for="BodyPart" class="ppe-input" /></label>
                <label class="ppe-field"><span>Характер травмы</span><input asp-for="InjuryNature" class="ppe-input" /></label>
                <label class="ppe-field"><span>Место</span><input asp-for="Place" class="ppe-input" /></label>
                <label class="ppe-field"><span>Описание</span><textarea asp-for="Description" class="ppe-input" rows="3"></textarea></label>
                <label class="ppe-check-row"><input type="checkbox" asp-for="Posted" /> Учтено</label>
                <div class="ppe-actions">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    @if (!string.IsNullOrWhiteSpace(Model.EditId))
                    {
                        <button type="submit" class="btn btn-outline" formaction="?handler=Delete" name="deleteId" value="@Model.EditId">Удалить</button>
                    }
                </div>
            </form>
        }
    </div>
</div>
