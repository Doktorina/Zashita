@page "/Med/Restrictions"
@model Zashita.Web.Pages.Med.RestrictionsModel
@{
    ViewData["Title"] = "Ограничения физ. лиц";
    ViewData["Subtitle"] = Model.Organization;
}

@section Styles {
  <style>
    .med-restrictions-grid th,
    .med-restrictions-grid td { vertical-align: top; }
    .med-restrictions-work-input { width: 100%; min-width: 14rem; min-height: 2.5rem; resize: vertical; }
    .med-restrictions-factors { white-space: normal; min-width: 10rem; }
    .med-restrictions-conclusion { white-space: nowrap; }
    .med-scan-modal {
      position: fixed; inset: 0; z-index: 1200;
      display: flex; align-items: center; justify-content: center;
      padding: 1.25rem;
    }
    .med-scan-modal[hidden] { display: none !important; }
    .med-scan-modal-backdrop {
      position: absolute; inset: 0; background: rgba(15, 26, 21, 0.55);
    }
    .med-scan-modal-dialog {
      position: relative; z-index: 1;
      width: min(960px, 96vw); height: min(88vh, 900px);
      background: var(--panel, #fff); color: inherit;
      border-radius: 10px; box-shadow: 0 16px 48px rgba(0,0,0,.28);
      display: flex; flex-direction: column; overflow: hidden;
    }
    .med-scan-modal-head {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 0.75rem 1rem; border-bottom: 1px solid rgba(15,26,21,.12);
    }
    .med-scan-modal-title { margin: 0; font-size: 1rem; font-weight: 600; }
    .med-scan-modal-actions { display: flex; align-items: center; gap: 6px; }
    .med-scan-modal-body { flex: 1; min-height: 0; background: #111; display: flex; align-items: center; justify-content: center; }
    .med-scan-preview-frame { width: 100%; height: 100%; border: 0; background: #fff; }
    .med-scan-preview-image { max-width: 100%; max-height: 100%; object-fit: contain; }
  </style>
}

<div class="panel ppe-panel med-doc-panel">
  @if (!string.IsNullOrWhiteSpace(Model.Message))
  {
    <p class="hint">@Model.Message</p>
  }

  <form method="get" id="med-restrictions-filter-form" class="training-report-filters sout-preparation-filters">
    <div class="training-planning-filter-grid">
      <label class="training-planning-filter-item">
        <span>Организация</span>
        <input type="text" class="ppe-input" value="@Model.Organization" readonly />
      </label>
      <label class="training-planning-filter-item">
        <span>Физ. лицо</span>
        <input name="employee" value="@Model.Employee" class="ppe-input" list="med-restrictions-employees" placeholder="все" autocomplete="off" />
      </label>
      <label class="training-planning-filter-item">
        <span>Поиск</span>
        <input name="q" value="@Model.Q" class="ppe-input" placeholder="ФИО, должность, факторы" autocomplete="off" />
      </label>
      <div class="training-planning-filter-item med-filter-actions">
        <span>&nbsp;</span>
        <button type="submit" class="btn btn-primary btn-sm">Показать</button>
      </div>
    </div>
  </form>

  <datalist id="med-restrictions-employees">
    @foreach (var employee in Model.Employees)
    {
      <option value="@employee"></option>
    }
  </datalist>

  <form method="post" asp-page-handler="Save" id="med-restrictions-save-form">
  <div class="ppe-toolbar sout-toolbar">
    <button type="submit" class="btn btn-primary btn-sm">Сохранить ограничения</button>
    <span class="hint">Строки подгружаются из отчёта по медосмотрам при заключении «Не годен» или «Ограниченно годен».</span>
  </div>

  <table class="data-grid sout-preparation-grid med-restrictions-grid" id="med-restrictions-grid">
    <thead>
      <tr>
        <th>ФИО</th>
        <th>Должность</th>
        <th>Факторы</th>
        <th>Ограничение по работе</th>
        <th>Скан заключения</th>
      </tr>
    </thead>
    <tbody>
      @if (Model.Rows.Count == 0)
      {
        <tr>
          <td colspan="5" class="hint">Нет сотрудников с заключением «Не годен» или «Ограниченно годен» в отчёте по медосмотрам.</td>
        </tr>
      }
      @foreach (var row in Model.Rows)
      {
        <tr>
          <td>
            @row.EmployeeName
            <input type="hidden" name="employeeName" value="@row.EmployeeName" />
          </td>
          <td>@row.Profession</td>
          <td class="med-restrictions-factors">@(string.IsNullOrWhiteSpace(row.Factors) ? "—" : row.Factors)</td>
          <td>
            <textarea name="workRestriction" class="ppe-input med-restrictions-work-input" rows="2" placeholder="Введите ограничение по работе">@row.WorkRestriction</textarea>
          </td>
          <td class="med-restrictions-conclusion">
            @if (!string.IsNullOrWhiteSpace(row.ConclusionScanExamId))
            {
              var scanExt = System.IO.Path.GetExtension(row.ConclusionScanFileName).ToLowerInvariant();
              var scanIsPdf = scanExt == ".pdf";
              var scanUrl = Url.Page("/Med/Status", "PreviewConclusionScan", new { examId = row.ConclusionScanExamId });
              <button type="button"
                      class="btn btn-outline btn-sm js-med-scan-preview"
                      data-scan-url="@scanUrl"
                      data-scan-pdf="@(scanIsPdf ? "1" : "0")"
                      data-scan-title="Скан: @row.EmployeeName"
                      title="Предпросмотр скана заключения">Скан</button>
            }
            else
            {
              <span class="hint">—</span>
            }
          </td>
        </tr>
      }
    </tbody>
  </table>
  </form>
</div>

<div id="med-scan-preview-modal" class="med-scan-modal" hidden>
  <div class="med-scan-modal-backdrop js-med-scan-close"></div>
  <div class="med-scan-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="med-scan-preview-title">
    <div class="med-scan-modal-head">
      <h3 id="med-scan-preview-title" class="med-scan-modal-title">Скан заключения</h3>
      <div class="med-scan-modal-actions">
        <a id="med-scan-preview-open" class="btn btn-outline btn-sm" href="#" target="_blank" rel="noopener">Открыть в новой вкладке</a>
        <button type="button" class="btn btn-outline btn-sm js-med-scan-close" title="Закрыть">×</button>
      </div>
    </div>
    <div class="med-scan-modal-body">
      <iframe id="med-scan-preview-frame" class="med-scan-preview-frame" title="Предпросмотр PDF" hidden></iframe>
      <img id="med-scan-preview-image" class="med-scan-preview-image" alt="Скан заключения" hidden />
    </div>
  </div>
</div>

@section Scripts {
  <script>
    (function () {
      var scanModal = document.getElementById('med-scan-preview-modal');
      var scanFrame = document.getElementById('med-scan-preview-frame');
      var scanImage = document.getElementById('med-scan-preview-image');
      var scanTitle = document.getElementById('med-scan-preview-title');
      var scanOpen = document.getElementById('med-scan-preview-open');

      function closeScanPreview() {
        if (!scanModal) return;
        scanModal.hidden = true;
        if (scanFrame) { scanFrame.hidden = true; scanFrame.removeAttribute('src'); }
        if (scanImage) { scanImage.hidden = true; scanImage.removeAttribute('src'); }
      }

      function openScanPreview(btn) {
        if (!scanModal || !btn) return;
        var url = btn.getAttribute('data-scan-url');
        if (!url) return;
        var isPdf = btn.getAttribute('data-scan-pdf') === '1';
        var title = btn.getAttribute('data-scan-title') || 'Скан заключения';
        if (scanTitle) scanTitle.textContent = title;
        if (scanOpen) scanOpen.href = url;
        if (isPdf) {
          if (scanImage) { scanImage.hidden = true; scanImage.removeAttribute('src'); }
          if (scanFrame) { scanFrame.hidden = false; scanFrame.src = url; }
        } else {
          if (scanFrame) { scanFrame.hidden = true; scanFrame.removeAttribute('src'); }
          if (scanImage) { scanImage.hidden = false; scanImage.src = url; }
        }
        scanModal.hidden = false;
      }

      document.addEventListener('click', function (event) {
        var previewBtn = event.target.closest('.js-med-scan-preview');
        if (previewBtn) {
          event.preventDefault();
          openScanPreview(previewBtn);
          return;
        }
        if (event.target.closest('.js-med-scan-close')) {
          closeScanPreview();
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeScanPreview();
      });
    })();
  </script>
}
