@page "/Tasks"
@model Zashita.Web.Pages.TasksModel
@{
    ViewData["Title"] = "Сроки и задачи";
    ViewData["Subtitle"] = Model.Organization;
}

<div class="panel ppe-panel">
  <div class="ppe-toolbar" style="flex-wrap:wrap;gap:8px;align-items:center">
    <a class="btn btn-outline btn-sm" asp-page="/Index">← На главную</a>
    <span class="hint">Всего: @Model.TotalCount · просрочено: <b class="@(Model.OverdueCount > 0 ? "text-danger" : "")">@Model.OverdueCount</b></span>
  </div>

  <p class="hint">
    Список задач по выбранной организации, разбитый по разделам.
    На главной показываются только ближайшие; здесь — полный перечень.
  </p>

  @if (Model.Sections.Count == 0)
  {
    <p class="hint">Нет открытых сроков и задач.</p>
  }

  @foreach (var block in Model.Sections)
  {
    <section class="panel" style="margin-top:16px;padding:14px 16px">
      <div class="panel-head-row">
        <h2 class="panel-title" style="margin:0;font-size:1.05rem">@block.Title <span class="hint">(@(block.TotalCount > 0 ? block.TotalCount : block.Items.Count))</span></h2>
        <a class="panel-head-link" href="@block.SectionUrl">Планирование →</a>
      </div>
      <ul class="deadline-list" style="margin-top:10px">
        @foreach (var row in block.Items)
        {
          <li>
            <a href="@row.Href" style="display:contents;color:inherit;text-decoration:none">
              <div class="deadline-main">
                <strong>@row.Title</strong>
                <span>@row.Subtitle</span>
              </div>
              <span class="badge badge-@row.BadgeKind">@row.Badge</span>
            </a>
          </li>
        }
      </ul>
    </section>
  }
</div>
