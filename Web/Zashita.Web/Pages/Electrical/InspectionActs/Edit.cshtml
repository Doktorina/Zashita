@page "/Electrical/InspectionActs/Edit"
@model Zashita.Web.Pages.Electrical.InspectionActs.EditModel
@{
    var doc = Model.Document;
}

<div class="panel ppe-panel">
  <form method="post" id="inspection-act-form">
    <div class="ppe-actions ppe-actions-top">
      <button type="submit" asp-page-handler="Save" class="btn btn-outline">Сохранить</button>
      <button type="submit" asp-page-handler="Post" class="btn btn-primary">Провести</button>
      <button type="submit" asp-page-handler="PostAndClose" class="btn btn-outline">Провести и закрыть</button>
      @if (!Model.IsNew)
      {
        <a class="btn btn-outline"
           href="/Electrical/InspectionActs/Preview?id=@Uri.EscapeDataString(doc.Id)">Печать</a>
        <button type="submit" asp-page-handler="Delete" class="btn btn-outline"
                onclick="return confirm('Удалить документ?');">Удалить</button>
      }
      <a class="btn btn-outline" asp-page="/Electrical/InspectionActs">К списку</a>
    </div>

    <div class="training-planning-filter-grid">
      <label class="training-planning-filter-item">
        <span>Номер</span>
        <input name="number" value="@doc.Number" class="ppe-input" required />
      </label>
      <label class="training-planning-filter-item">
        <span>Дата</span>
        <input name="date" type="datetime-local"
               value="@doc.Date.ToString("yyyy-MM-ddTHH:mm")" class="ppe-input" required />
      </label>
      <label class="training-planning-filter-item training-filter-span-2">
        <span>Объект строительства</span>
        <input name="constructionObject" value="@doc.ConstructionObject" class="ppe-input" required
               placeholder="ЖК Орбита по адресу: г. Екатеринбург, ул. Монтерская, 10" />
      </label>
      <label class="training-planning-filter-item training-filter-span-2">
        <span>Подрядчик</span>
        <input name="contractor" value="@doc.Contractor" class="ppe-input"
               placeholder='ООО "Отдел Строй"' />
      </label>
      <label class="training-planning-filter-item">
        <span>Представитель (должность)</span>
        <input name="representativeTitle" value="@doc.RepresentativeTitle" class="ppe-input"
               placeholder="Мастер СМР ООО 'Отдел Строй'" />
      </label>
      <label class="training-planning-filter-item">
        <span>Представитель (Ф.И.О.)</span>
        <input name="representativeName" value="@doc.RepresentativeName" class="ppe-input"
               list="inspection-act-employees" placeholder="Затопляев Е.И." />
      </label>
      <label class="training-planning-filter-item">
        <span>Составитель (должность)</span>
        <input name="inspectorTitle" value="@doc.InspectorTitle" class="ppe-input" />
      </label>
      <label class="training-planning-filter-item">
        <span>Составитель (Ф.И.О.)</span>
        <input name="inspectorName" value="@doc.InspectorName" class="ppe-input"
               list="inspection-act-employees" placeholder="Чудинова А." />
      </label>
      <label class="training-planning-filter-item">
        <span>Количество фото (приложение)</span>
        <input name="photoCount" type="number" min="0" value="@doc.PhotoCount" class="ppe-input" />
      </label>
    </div>

    <datalist id="inspection-act-employees">
      @foreach (var name in Model.EmployeeNames)
      {
        <option value="@name"></option>
      }
    </datalist>

    <h3 class="ppe-step-subtitle">Нарушения</h3>
    <table class="data-grid" id="inspection-act-violations">
      <thead>
        <tr>
          <th class="ot-act-col-no">№</th>
          <th>Наименование нарушений</th>
          <th>Нарушенные НПА</th>
          <th>Место нарушения</th>
          <th>Срок устранения</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        @for (var i = 0; i < doc.Violations.Count; i++)
        {
          var line = doc.Violations[i];
          <tr class="inspection-act-violation-row">
            <td class="ot-act-col-no inspection-act-row-no">@(i + 1)</td>
            <td><textarea name="violationDescription" class="ppe-input inspection-act-textarea" rows="5">@line.Description</textarea></td>
            <td><textarea name="violationRegulations" class="ppe-input inspection-act-textarea" rows="5">@line.Regulations</textarea></td>
            <td><input name="violationLocation" value="@line.Location" class="ppe-input" /></td>
            <td><input name="violationDeadline" type="datetime-local"
                       value="@(line.Deadline?.ToString("yyyy-MM-ddTHH:mm") ?? "")" class="ppe-input" /></td>
            <td class="ppe-line-actions">
              <button type="button" class="suot-action" data-action="remove-violation" title="Удалить">✕</button>
            </td>
          </tr>
        }
      </tbody>
    </table>
    <div class="ppe-actions ppe-actions-inline">
      <button type="button" class="btn btn-outline btn-sm" id="inspection-act-add-row">Добавить строку</button>
    </div>
  </form>
</div>

<script src="/js/inspection-act-lines.js" asp-append-version="true"></script>
