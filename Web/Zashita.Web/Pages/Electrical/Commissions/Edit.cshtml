@page "/Electrical/Commissions/Edit"
@using Zashita.Core.Electrical
@model Zashita.Web.Pages.Electrical.Commissions.EditModel
@{
    var r = Model.Record;
    var isGroup = r.IsGroup || Model.IsGroup;
    ViewData["Title"] = Model.IsNew ? "Комиссия по ЭБ (создание)" : r.Name;
    ViewData["Subtitle"] = Model.Organization;
    var members = r.Members ?? [];
    if (!isGroup && members.Count == 0)
    {
        members =
        [
            new ElectricalCommissionMember
            {
                Status = ElectricalCommissionMemberHelpers.ChairmanStatus
            }
        ];
    }

    var employeesJson = Model.EmployeesJson;
}

<link rel="stylesheet" href="/css/sout-catalog.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/electrical-register.css" asp-append-version="true" />

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
  <p class="@(Model.IsError ? "form-error" : "text-success")">@Model.Message</p>
}

<div class="panel ppe-panel sout-catalog-edit">
  <form method="post" asp-page="/Electrical/Commissions/Edit" id="eb-commission-edit-form">
    <input type="hidden" name="recordId" value="@r.Id" />
    <input type="hidden" asp-for="Id" />
    <input type="hidden" name="isGroup" value="@isGroup.ToString().ToLowerInvariant()" />

    <div class="sout-assignment-toolbar sout-catalog-edit-toolbar">
      <div class="sout-assignment-toolbar-left">
        <a class="btn btn-outline btn-sm" asp-page="/Electrical/Commissions">←</a>
        <button type="submit" formaction="?handler=SaveAndClose" class="btn btn-primary btn-sm">Записать и закрыть</button>
        <button type="submit" formaction="?handler=Save" class="btn btn-outline btn-sm">Записать</button>
      </div>
    </div>

    <div class="sout-catalog-edit-body">
      <label class="ppe-field">
        <span>Наименование</span>
        <input name="name" value="@r.Name" class="ppe-input" required autofocus />
      </label>

      <label class="ppe-field">
        <span>Входит в группу</span>
        <select name="parentId" class="ppe-input">
          <option value="">—</option>
          @foreach (var group in Model.GroupOptions.Where(g => g.Id != r.Id))
          {
            if (string.Equals(r.ParentId, group.Id, StringComparison.Ordinal))
            {
              <option value="@group.Id" selected>@group.Name</option>
            }
            else
            {
              <option value="@group.Id">@group.Name</option>
            }
          }
        </select>
      </label>

      @if (!isGroup)
      {
        <div class="ppe-field">
          <span>Состав</span>
          <p class="hint" style="margin:4px 0 8px">ФИО только из реестра «Проверка знаний ЭБ» — должность подставится автоматически.</p>
          @if (Model.EmployeeOptions.Count == 0)
          {
            <p class="form-error">Сначала добавьте сотрудников в «Проверка знаний ЭБ».</p>
          }
          <table class="data-grid ppe-edit-grid" id="eb-commission-members-grid">
            <thead>
              <tr>
                <th style="min-width:14rem">Статус</th>
                <th style="min-width:12rem">Должность</th>
                <th style="min-width:14rem">ФИО</th>
                <th>Аттестован в Ростехнадзоре</th>
                <th class="ppe-line-actions"></th>
              </tr>
            </thead>
            <tbody id="eb-commission-members-body">
              @foreach (var member in members)
              {
                <tr class="eb-commission-member-row">
                  <td>
                    <select name="memberStatus" class="ppe-input">
                      @foreach (var status in Model.StatusOptions)
                      {
                        if (string.Equals(status, member.Status, StringComparison.OrdinalIgnoreCase))
                        {
                          <option value="@status" selected>@status</option>
                        }
                        else
                        {
                          <option value="@status">@status</option>
                        }
                      }
                    </select>
                  </td>
                  <td>
                    <input name="memberPosition" value="@member.Position" class="ppe-input eb-commission-position" autocomplete="off" />
                  </td>
                  <td>
                    <input name="memberName" value="@member.Name" class="ppe-input eb-commission-name"
                           list="eb-commission-employees" autocomplete="off" placeholder="Выберите из реестра ЭБ…" />
                  </td>
                  <td>
                    <input type="hidden" name="memberCertified" value="@(member.CertifiedInRostechnadzor ? "true" : "false")" class="eb-certified-flag" />
                    <input type="checkbox" class="eb-certified-check" @(member.CertifiedInRostechnadzor ? "checked" : "") />
                  </td>
                  <td class="ppe-line-actions">
                    <button type="button" class="suot-action suot-action-danger" data-action="remove-member" title="Удалить">✕</button>
                  </td>
                </tr>
              }
            </tbody>
          </table>
          <datalist id="eb-commission-employees">
            @foreach (var emp in Model.EmployeeOptions)
            {
              <option value="@emp.Name"></option>
            }
          </datalist>
          <div class="ppe-actions ppe-actions-inline" style="margin-top:8px">
            <button type="button" class="btn btn-outline btn-sm" id="eb-commission-add-member">Добавить участника</button>
          </div>
        </div>

        <div class="sout-catalog-edit-grid">
          <label class="ppe-field">
            <span>№ приказа о создании комиссии</span>
            <input name="orderNumber" value="@r.OrderNumber" class="ppe-input" />
          </label>
          <label class="ppe-field">
            <span>Дата приказа о создании комиссии</span>
            <input type="date" name="orderDate" value="@r.OrderDate?.ToString("yyyy-MM-dd")" class="ppe-input" />
          </label>
          <label class="ppe-field">
            <span>Дата утверждения состава</span>
            <input type="date" name="compositionApprovalDate" value="@r.CompositionApprovalDate?.ToString("yyyy-MM-dd")" class="ppe-input" />
          </label>
          <label class="ppe-field">
            <span>Периодичность проверки состава, мес.</span>
            <input type="number" min="1" name="compositionCheckPeriodMonths" value="@r.CompositionCheckPeriodMonths" class="ppe-input" />
          </label>
        </div>
      }
    </div>
  </form>
</div>

<template id="eb-commission-member-template">
  <tr class="eb-commission-member-row">
    <td>
      <select name="memberStatus" class="ppe-input">
        @foreach (var status in Model.StatusOptions)
        {
          <option value="@status">@status</option>
        }
      </select>
    </td>
    <td>
      <input name="memberPosition" value="" class="ppe-input eb-commission-position" autocomplete="off" />
    </td>
    <td>
      <input name="memberName" value="" class="ppe-input eb-commission-name" list="eb-commission-employees" autocomplete="off" placeholder="Выберите из реестра ЭБ…" />
    </td>
    <td>
      <input type="hidden" name="memberCertified" value="false" class="eb-certified-flag" />
      <input type="checkbox" class="eb-certified-check" />
    </td>
    <td class="ppe-line-actions">
      <button type="button" class="suot-action suot-action-danger" data-action="remove-member" title="Удалить">✕</button>
    </td>
  </tr>
</template>

@section Scripts {
  <script>
    (function () {
      var employees = @Html.Raw(employeesJson);
      var byName = {};
      employees.forEach(function (e) {
        if (e && e.name) byName[String(e.name).trim().toLowerCase()] = e.position || '';
      });

      var body = document.getElementById('eb-commission-members-body');
      var addBtn = document.getElementById('eb-commission-add-member');
      var template = document.getElementById('eb-commission-member-template');
      if (!body || !template) return;

      function defaultStatusForNewRow() {
        var hasChairman = false;
        var maxMember = 0;
        body.querySelectorAll('select[name="memberStatus"]').forEach(function (sel) {
          var v = (sel.value || '').trim();
          if (v === 'Председатель комиссии по ЭБ') hasChairman = true;
          var m = /^Член комиссии\s+(\d+)/i.exec(v);
          if (m) {
            var n = parseInt(m[1], 10);
            if (n > maxMember) maxMember = n;
          }
        });
        if (!hasChairman) return 'Председатель комиссии по ЭБ';
        return 'Член комиссии ' + (maxMember + 1);
      }

      function fillPositionFromName(row) {
        var nameInput = row.querySelector('.eb-commission-name');
        var posInput = row.querySelector('.eb-commission-position');
        if (!nameInput || !posInput) return;
        var key = (nameInput.value || '').trim().toLowerCase();
        if (key && Object.prototype.hasOwnProperty.call(byName, key)) {
          posInput.value = byName[key];
        }
      }

      body.addEventListener('change', function (e) {
        var row = e.target.closest('.eb-commission-member-row');
        if (!row) return;
        if (e.target.classList.contains('eb-commission-name')) fillPositionFromName(row);
        if (e.target.classList.contains('eb-certified-check')) {
          var flag = row.querySelector('.eb-certified-flag');
          if (flag) flag.value = e.target.checked ? 'true' : 'false';
        }
      });
      body.addEventListener('input', function (e) {
        var row = e.target.closest('.eb-commission-member-row');
        if (row && e.target.classList.contains('eb-commission-name')) fillPositionFromName(row);
      });
      body.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-action="remove-member"]');
        if (!btn) return;
        var row = btn.closest('.eb-commission-member-row');
        if (row) row.remove();
      });

      addBtn?.addEventListener('click', function () {
        var node = template.content.cloneNode(true);
        var row = node.querySelector('tr');
        var sel = row.querySelector('select[name="memberStatus"]');
        if (sel) sel.value = defaultStatusForNewRow();
        body.appendChild(node);
      });
    })();
  </script>
}
