@page "/Ppe/Acceptance"
@model Zashita.Web.Pages.Ppe.Acceptance.IndexModel
@{
    ViewData["Title"] = "Приемка спецодежды, СИЗ";
    ViewData["Subtitle"] = Model.Organization;
}

@section Styles {
  <link rel="stylesheet" href="~/css/med-person-list.css" asp-append-version="true" />
}

<div class="panel ppe-panel med-doc-panel">
  <div class="ppe-toolbar sout-toolbar">
    <a class="btn btn-primary btn-sm" asp-page="/Ppe/Acceptance/Edit">Создать</a>
    @if (!string.IsNullOrWhiteSpace(Model.PrintId))
    {
      <a class="btn btn-outline btn-sm" asp-page="/Ppe/Acceptance/Edit" asp-route-id="@Model.PrintId">Перейти</a>
    }
    else
    {
      <button type="button" class="btn btn-outline btn-sm" disabled>Перейти</button>
    }

    <span class="hint ppe-print-selected" id="ppe-acceptance-selected-hint">
      @(Model.SelectedPrintDocument is not null ? $"Для печати: {Model.SelectedPrintDocument.Number}" : "")
    </span>

    <details class="ppe-print-menu med-print-menu-open" id="ppe-acceptance-print-menu">
      <summary class="btn btn-outline btn-sm">Печать ▾</summary>
      <div class="ppe-print-dropdown">
        <a class="med-print-link @(string.IsNullOrWhiteSpace(Model.PrintId) ? "training-print-disabled" : "")"
           data-href-template="/Ppe/Acceptance/PrintReturnStatement?id={id}"
           href="@(string.IsNullOrWhiteSpace(Model.PrintId) ? "#" : $"/Ppe/Acceptance/PrintReturnStatement?id={Uri.EscapeDataString(Model.PrintId!)}")"
           @(string.IsNullOrWhiteSpace(Model.PrintId) ? "aria-disabled=true tabindex=-1" : "")>
          Ведомость сдачи работниками специальной одежды
        </a>
        <a class="med-print-link @(string.IsNullOrWhiteSpace(Model.PrintId) ? "training-print-disabled" : "")"
           data-href-template="/Ppe/Acceptance/PrintMaterialReturn?id={id}"
           href="@(string.IsNullOrWhiteSpace(Model.PrintId) ? "#" : $"/Ppe/Acceptance/PrintMaterialReturn?id={Uri.EscapeDataString(Model.PrintId!)}")"
           @(string.IsNullOrWhiteSpace(Model.PrintId) ? "aria-disabled=true tabindex=-1" : "")>
          Возврат материалов
        </a>
      </div>
    </details>
  </div>

  <form method="get" id="ppe-acceptance-filter-form" class="training-report-filters sout-preparation-filters">
    <input type="hidden" name="printId" id="ppe-acceptance-print-id" value="@Model.PrintId" />
    <div class="training-planning-filter-grid">
      <label class="training-planning-filter-item"><span>Организация</span><input class="ppe-input" value="@Model.Organization" readonly /></label>
      <label class="training-planning-filter-item">
        <span>Подразделение</span>
        <select name="department" class="ppe-input" onchange="this.form.submit()">
          <option value="">все</option>
          @if (Model.Department == "__empty__")
          {
            <option value="__empty__" selected>Без подразделения</option>
          }
          else
          {
            <option value="__empty__">Без подразделения</option>
          }
          @foreach (var dep in Model.Departments)
          {
            if (dep == Model.Department)
            {
              <option value="@dep" selected>@dep</option>
            }
            else
            {
              <option value="@dep">@dep</option>
            }
          }
        </select>
      </label>
      <label class="training-planning-filter-item training-assistant-wizard-check">
        <span>&nbsp;</span>
        <span class="med-filter-inline"><input type="hidden" name="inGroup" value="false" /><input type="checkbox" name="inGroup" value="true" @(Model.InGroup ? "checked" : null) /><span>В группе</span></span>
      </label>
      <label class="training-planning-filter-item"><span>Поиск</span><input name="q" value="@Model.Q" class="ppe-input" placeholder="номер, склад" /></label>
    </div>
  </form>

  <table class="data-grid sout-preparation-grid med-person-list-grid" id="ppe-acceptance-grid">
    <thead>
      <tr>
        <th class="med-status-col"></th>
        <th>Дата</th>
        <th>Номер</th>
        <th>Подразделение</th>
        <th>Склад</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var row in Model.Rows)
      {
        var isSelected = !string.IsNullOrWhiteSpace(Model.PrintId) && Model.PrintId == row.Id;
        <tr class="med-person-list-row @(isSelected ? "training-row-active" : "")" data-id="@row.Id" data-number="@row.Number">
          <td class="med-status-col"><span class="med-doc-status @(row.IsPosted ? "med-doc-status-posted" : "med-doc-status-draft")"></span></td>
          <td>@row.Date.ToString("dd.MM.yyyy")</td>
          <td><a asp-page="/Ppe/Acceptance/Edit" asp-route-id="@row.Id">@row.Number</a></td>
          <td>@row.Department</td>
          <td>@row.Warehouse</td>
        </tr>
      }
    </tbody>
  </table>
</div>

@section Scripts {
  <script src="~/js/med-doc-list.js" asp-append-version="true"></script>
  <script>document.addEventListener('DOMContentLoaded',function(){initMedDocList({gridId:'ppe-acceptance-grid',printIdInputId:'ppe-acceptance-print-id',filterFormId:'ppe-acceptance-filter-form',selectedHintId:'ppe-acceptance-selected-hint',printMenuId:'ppe-acceptance-print-menu',editUrlPrefix:'/Ppe/Acceptance/Edit?id=',autoSelectFirst:true});});</script>
}
