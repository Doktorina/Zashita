@page "/Risks/Documents"
@model Zashita.Web.Pages.Risks.DocumentsModel
@{
    ViewData["Title"] = " ";
    ViewData["Subtitle"] = Model.Organization;
    var isHub = Model.ActiveTab == "hub";
    var isOrder = Model.ActiveTab == "order";
    var isPrep = Model.ActiveTab == "preparation";
}

@section Styles {
  <link rel="stylesheet" href="~/css/risks-preparation.css" asp-append-version="true" />
  <style>
    .page-title { display: none; }
  </style>
}

<div class="panel ppe-panel risks-doc-panel">
@if (isHub)
{
  <div class="risks-docs-hub" aria-label="Документы оценки рисков">
    <a class="risks-docs-tile" asp-page="/Risks/UnscheduledOrders/SelectCommission">
      <span class="risks-docs-tile-title">Приказ на оценку рисков</span>
      <span class="risks-docs-tile-hint">Выбор комиссии, список и печать приказа</span>
    </a>
    <a class="risks-docs-tile" asp-page="/Risks/Documents/SelectWorkplaces">
      <span class="risks-docs-tile-title">Перечень РМ (выбор)</span>
      <span class="risks-docs-tile-hint">По объектам; отмечены профессии с оценкой</span>
    </a>
    <a class="risks-docs-tile" asp-page="/Risks/Documents/SelectHazards" asp-route-purpose="registry">
      <span class="risks-docs-tile-title">Реестр опасностей (выбор)</span>
      <span class="risks-docs-tile-hint">Печать реестра · Сохранить реестр в Word</span>
    </a>
    <a class="risks-docs-tile" asp-page="/Risks/Documents/SelectHazards" asp-route-purpose="measures">
      <span class="risks-docs-tile-title">Перечень мер управления</span>
      <span class="risks-docs-tile-hint">Печать мер · Сохранить меры в Word</span>
    </a>
    <a class="risks-docs-tile" asp-page="/Risks/Documents/SelectWorkplaces" asp-route-purpose="cards">
      <span class="risks-docs-tile-title">Карты идентификации</span>
      <span class="risks-docs-tile-hint">Сводная ведомость карт идентификации</span>
    </a>
    <a class="risks-docs-tile" asp-page="/Risks/Documents/OrgDocPreview" asp-route-kind="title-page" target="_blank">
      <span class="risks-docs-tile-title">Титульный лист</span>
      <span class="risks-docs-tile-hint">Печать титульного листа отчёта ОПР</span>
    </a>
    <a class="risks-docs-tile" asp-page="/Risks/Documents/RegulationTemplate">
      <span class="risks-docs-tile-title">Положение (методика)</span>
      <span class="risks-docs-tile-hint">Полный текст методики; организация в колонтитуле</span>
    </a>
  </div>
}
else if (isOrder)
{
  <div class="risks-docs-section">
    <div class="risks-docs-back-row">
      <a class="btn btn-outline btn-sm" asp-page="/Risks/Documents">← К документам</a>
    </div>
    <div class="ppe-toolbar sout-toolbar">
      <a class="btn btn-primary btn-sm" asp-page="/Risks/UnscheduledOrders/SelectCommission">Создать приказ</a>
      @if (!string.IsNullOrWhiteSpace(Model.PrintId) && Model.SelectedOrder is not null)
      {
        <a class="btn btn-outline btn-sm" asp-page="/Risks/UnscheduledOrders/Edit" asp-route-id="@Model.PrintId">Перейти</a>
        <a class="btn btn-outline btn-sm"
           asp-page="/Risks/UnscheduledOrders/Preview"
           asp-route-id="@Model.PrintId"
           asp-route-mode="order"
           target="_blank">Печать / предпросмотр</a>
        <button type="button" class="btn btn-outline btn-sm"
                data-risks-export="word"
                data-risks-export-url="/Risks/UnscheduledOrders/Preview?id=@Uri.EscapeDataString(Model.PrintId)&amp;mode=order">Word</button>
      }
      else
      {
        <button type="button" class="btn btn-outline btn-sm" disabled>Перейти</button>
      }
    </div>
    <h2 class="ppe-subtitle risks-docs-section-title">Приказ на оценку рисков</h2>
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
      <p class="text-success">@Model.Message</p>
    }

    <form method="get" id="risks-docs-order-filter" class="training-report-filters">
      <input type="hidden" name="tab" value="order" />
      <input type="hidden" name="printId" id="risks-docs-order-print-id" value="@Model.PrintId" />
      <div class="training-planning-filter-grid">
        <label class="training-planning-filter-item">
          <span>Организация</span>
          <input type="text" class="ppe-input" value="@Model.Organization" readonly />
        </label>
        <label class="training-planning-filter-item">
          <span>Подразделение</span>
          <input name="department" value="@Model.Department" class="ppe-input" list="risks-docs-departments" placeholder="все" />
        </label>
        <label class="training-planning-filter-item">
          <span>Поиск</span>
          <input name="q" value="@Model.Q" class="ppe-input" placeholder="номер, подразделение" />
        </label>
      </div>
    </form>

    <table class="data-grid sout-preparation-grid" id="risks-docs-order-grid">
      <thead>
        <tr>
          <th>Дата</th>
          <th>Номер</th>
          <th>Подразделение</th>
          <th>Статус</th>
          <th style="width:6rem"></th>
        </tr>
      </thead>
      <tbody>
        @if (Model.OrderRows.Count == 0)
        {
          <tr><td colspan="5" class="hint">Приказов пока нет. Нажмите «Создать приказ».</td></tr>
        }
        @foreach (var row in Model.OrderRows)
        {
          var selected = Model.PrintId == row.Id;
          <tr class="sout-preparation-row @(selected ? "training-row-active" : "")" data-id="@row.Id">
            <td>@row.Date.ToString("dd.MM.yyyy")</td>
            <td><a asp-page="/Risks/UnscheduledOrders/Edit" asp-route-id="@row.Id">@row.Number</a></td>
            <td>@(string.IsNullOrWhiteSpace(row.Department) ? "—" : row.Department)</td>
            <td>@(row.IsPosted ? "Проведён" : "Черновик")</td>
            <td>
              <form method="post" asp-page-handler="DeleteOrder" style="display:inline"
                    onsubmit="return confirm('Удалить приказ «@row.Number» от @row.Date.ToString("dd.MM.yyyy")?');">
                <input type="hidden" name="tab" value="order" />
                <input type="hidden" name="id" value="@row.Id" />
                <input type="hidden" name="department" value="@Model.Department" />
                <input type="hidden" name="q" value="@Model.Q" />
                <button type="submit" class="btn btn-outline btn-sm btn-danger" title="Удалить приказ">Удалить</button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}
else
{
  <div class="risks-docs-section">
    <div class="risks-docs-back-row">
      <a class="btn btn-outline btn-sm" asp-page="/Risks/Documents">← К документам</a>
    </div>
    <div class="ppe-toolbar sout-toolbar">
      <a class="btn btn-primary btn-sm" asp-page="/Risks/Preparation/Edit">Создать подготовку</a>
      @if (!string.IsNullOrWhiteSpace(Model.PrintId) && Model.SelectedPreparation is not null)
      {
        <a class="btn btn-outline btn-sm" asp-page="/Risks/Preparation/Edit" asp-route-id="@Model.PrintId">Перейти</a>
      }
      <details class="ppe-print-menu risks-print-menu-open">
        <summary class="btn btn-outline btn-sm">Печать ▾</summary>
        <div class="ppe-print-dropdown">
          @if (!string.IsNullOrWhiteSpace(Model.PrintId))
          {
            var pid = Uri.EscapeDataString(Model.PrintId);
            <a href="/Risks/Preparation/Preview?id=@pid&amp;mode=schedule" target="_blank">График (по месяцам)</a>
            <a href="/Risks/Preparation/Preview?id=@pid&amp;mode=schedule-weekly" target="_blank">График (по неделям)</a>
            <a href="/Risks/Preparation/Preview?id=@pid&amp;mode=order" target="_blank">Приказ о комиссии</a>
            <a href="/Risks/Documents/SelectWorkplaces?prepId=@pid">Перечень РМ (выбор профессий)</a>
            <div class="risks-print-export-row" style="padding:8px 12px;gap:8px">
              <span class="hint">Скачать график:</span>
              <button type="button" class="btn btn-outline btn-sm" data-risks-export="word" data-risks-export-url="/Risks/Preparation/Preview?id=@pid&amp;mode=schedule">Word</button>
            </div>
          }
          else
          {
            <span class="ppe-print-disabled">Выберите документ в списке</span>
          }
        </div>
      </details>
    </div>
    <h2 class="ppe-subtitle risks-docs-section-title">Подготовка к проведению оценки рисков</h2>

    <form method="get" id="risks-docs-prep-filter" class="training-report-filters">
      <input type="hidden" name="tab" value="preparation" />
      <input type="hidden" name="printId" id="risks-docs-prep-print-id" value="@Model.PrintId" />
      <div class="training-planning-filter-grid">
        <label class="training-planning-filter-item">
          <span>Организация</span>
          <input type="text" class="ppe-input" value="@Model.Organization" readonly />
        </label>
        <label class="training-planning-filter-item">
          <span>Подразделение</span>
          <input name="department" value="@Model.Department" class="ppe-input" list="risks-docs-departments" placeholder="все" />
        </label>
        <label class="training-planning-filter-item">
          <span>Поиск</span>
          <input name="q" value="@Model.Q" class="ppe-input" placeholder="номер, подразделение" />
        </label>
      </div>
    </form>

    <table class="data-grid sout-preparation-grid" id="risks-docs-prep-grid">
      <thead>
        <tr>
          <th>Дата</th>
          <th>Номер</th>
          <th>Подразделение</th>
          <th>Статус</th>
        </tr>
      </thead>
      <tbody>
        @if (Model.PreparationRows.Count == 0)
        {
          <tr><td colspan="4" class="hint">Документов пока нет. Нажмите «Создать подготовку».</td></tr>
        }
        @foreach (var row in Model.PreparationRows)
        {
          var selected = Model.PrintId == row.Id;
          <tr class="sout-preparation-row @(selected ? "training-row-active" : "")" data-id="@row.Id">
            <td>@row.Date.ToString("dd.MM.yyyy")</td>
            <td><a asp-page="/Risks/Preparation/Edit" asp-route-id="@row.Id">@row.Number</a></td>
            <td>@(string.IsNullOrWhiteSpace(row.Department) ? "—" : row.Department)</td>
            <td>@(row.IsPosted ? "Проведён" : "Черновик")</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}

  <datalist id="risks-docs-departments">
    @foreach (var department in Model.Departments)
    {
      <option value="@department"></option>
    }
  </datalist>
</div>

@section Scripts {
  <script src="~/js/risks-doc-export.js" asp-append-version="true"></script>
  <script>
    (function () {
      function bindGrid(gridId, printIdInputId, tab) {
        var grid = document.getElementById(gridId);
        var printId = document.getElementById(printIdInputId);
        if (!grid || !printId) return;
        grid.querySelectorAll('tr[data-id]').forEach(function (row) {
          row.addEventListener('click', function (e) {
            if (e.target.closest('a, button, form, input')) return;
            printId.value = row.getAttribute('data-id') || '';
            var url = '/Risks/Documents?tab=' + encodeURIComponent(tab) + '&printId=' + encodeURIComponent(printId.value);
            var dept = document.querySelector('input[name="department"]');
            var q = document.querySelector('input[name="q"]');
            if (dept && dept.value) url += '&department=' + encodeURIComponent(dept.value);
            if (q && q.value) url += '&q=' + encodeURIComponent(q.value);
            window.location.href = url;
          });
        });
      }
      bindGrid('risks-docs-order-grid', 'risks-docs-order-print-id', 'order');
      bindGrid('risks-docs-prep-grid', 'risks-docs-prep-print-id', 'preparation');
    })();
  </script>
}
