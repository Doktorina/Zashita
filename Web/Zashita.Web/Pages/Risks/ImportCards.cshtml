@page "/Risks/ImportCards"
@model Zashita.Web.Pages.Risks.ImportCardsModel
@{
    ViewData["Title"] = "Импорт карт из Word";
    ViewData["Subtitle"] = Model.Organization;
}

<div class="panel ppe-panel">
  <p class="hint">
    Загрузите <b>один или несколько</b> .docx с картами идентификации.
    Система сама читает из файла <b>организацию</b> и <b>профессию</b>, находит нужное рабочее место
    (в любой компании) и заполняет таблицу опасностей. Поддерживаются разные шаблоны Word.
  </p>

  @if (!string.IsNullOrWhiteSpace(Model.Message))
  {
    <p class="@(Model.IsError ? "form-error" : "text-success")">@Model.Message</p>
  }

  <div class="ppe-toolbar" style="margin-bottom:14px">
    <a class="btn btn-outline btn-sm" asp-page="/Risks/Workplaces" asp-route-view="assessment">Карты оценки</a>
    <a class="btn btn-outline btn-sm" asp-page="/Risks/AssessmentList">Перечень к оценке</a>
  </div>

  <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="ppe-form">
    <label class="ppe-field">
      <span>Файлы .docx (можно несколько)</span>
      <input type="file"
             name="uploadFiles"
             accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
             class="ppe-input"
             multiple />
    </label>
    <label class="ppe-field" style="display:flex;align-items:center;gap:8px">
      <input type="checkbox" name="autoApply" value="true" checked />
      <span>сразу записать в карты (без превью)</span>
    </label>
    <label class="ppe-field" style="display:flex;align-items:center;gap:8px">
      <input type="checkbox" name="overwriteExisting" value="true" />
      <span>перезаписать уже заполненные карты</span>
    </label>
    <div class="ppe-actions">
      <button type="submit" class="btn btn-primary">Загрузить и вставить</button>
    </div>
  </form>

  @if (Model.Draft is { Items.Count: > 0 })
  {
    <hr style="margin:22px 0" />
    <h3 class="ppe-step-title">Превью: @Model.Draft.Items.Count карт из «@Model.Draft.SourceFileName»</h3>

    <form method="post" asp-page-handler="Apply">
      <input type="hidden" name="draftId" value="@Model.Draft.Id" />

      <table class="data-grid">
        <thead>
          <tr>
            <th></th>
            <th>Карта / организация из Word</th>
            <th>Профессия / подразделение</th>
            <th>Дата / риск</th>
            <th>Опасностей</th>
            <th>Рабочее место</th>
            <th>Перезаписать</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Draft.Items)
        {
          var card = item.Card;
          <tr>
            <td>
              <input type="checkbox" name="selected" value="@item.ItemKey" @(item.Selected ? "checked" : null) />
            </td>
            <td>
              № @(string.IsNullOrWhiteSpace(card.CardNumber) ? "—" : card.CardNumber)
              <div class="hint">@(string.IsNullOrWhiteSpace(card.Organization) ? "—" : card.Organization)</div>
              @if (!string.IsNullOrWhiteSpace(card.CompiledBy))
              {
                <div class="hint">составил: @card.CompiledBy</div>
              }
            </td>
            <td>
              <div>@(string.IsNullOrWhiteSpace(card.Profession) ? "—" : card.Profession)</div>
              <div class="hint">@(string.IsNullOrWhiteSpace(card.Department) ? "" : card.Department)</div>
              @if (!string.IsNullOrWhiteSpace(item.MatchNote))
              {
                <div class="hint">@item.MatchNote</div>
              }
            </td>
            <td>
              @(card.AssessmentDate?.ToString("dd.MM.yyyy") ?? "—")
              <div class="hint">@(string.IsNullOrWhiteSpace(card.OverallRisk) ? "" : card.OverallRisk)</div>
            </td>
            <td>@card.Lines.Count</td>
            <td>
              <select name="wp_@item.ItemKey" class="ppe-input" style="min-width:260px">
                <option value="">— не выбрано —</option>
                @foreach (var opt in Model.WorkplaceOptions)
                {
                  if (string.Equals(opt.Value, item.MatchedWorkplaceId, StringComparison.OrdinalIgnoreCase))
                  {
                    <option value="@opt.Value" selected>@opt.Text</option>
                  }
                  else
                  {
                    <option value="@opt.Value">@opt.Text</option>
                  }
                }
              </select>
              @if (item.ExistingLineCount > 0)
              {
                <div class="hint">уже строк: @item.ExistingLineCount</div>
              }
            </td>
            <td>
              @if (item.ExistingLineCount > 0)
              {
                <input type="checkbox" name="overwrite" value="@item.ItemKey" />
              }
              else
              {
                <span class="hint">—</span>
              }
            </td>
          </tr>
        }
        </tbody>
      </table>

      <div class="ppe-actions" style="margin-top:14px">
        <button type="submit" class="btn btn-primary">Записать в карты</button>
      </div>
    </form>
  }
</div>
