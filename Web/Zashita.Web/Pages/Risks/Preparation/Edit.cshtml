@page "/Risks/Preparation/Edit"
@model Zashita.Web.Pages.Risks.Preparation.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Подготовка к проведению оценки рисков. Новый" : "Подготовка к проведению оценки рисков";
    ViewData["Subtitle"] = Model.Organization;
    var doc = Model.Document;
}

@section Styles {
  <link rel="stylesheet" href="~/css/risks-preparation.css" asp-append-version="true" />
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
  <p class="@(Model.IsError ? "form-error" : "text-success")">@Model.Message</p>
}

<div class="panel ppe-panel sout-assignment-doc">
  <div class="risks-docs-back-row">
    <a class="btn btn-outline btn-sm" asp-page="/Risks/Documents" asp-route-tab="preparation">← К документам</a>
  </div>
  <form method="post" asp-page="/Risks/Preparation/Edit">
    <input type="hidden" asp-for="Id" />

    <div class="sout-assignment-toolbar">
      <div class="sout-assignment-toolbar-left">
        <button type="submit" formaction="?handler=PostAndClose" class="btn btn-primary btn-sm">Провести и закрыть</button>
        <button type="submit" formaction="?handler=Save" class="btn btn-outline btn-sm">Записать</button>
        <button type="submit" formaction="?handler=Post" class="btn btn-outline btn-sm">Провести</button>
      </div>
      <div class="sout-assignment-toolbar-right">
        <span class="hint sout-assignment-status">@(doc.IsPosted ? "Проведён" : "Новый *")</span>
      </div>
    </div>

    <div class="sout-assignment-header">
      <div class="sout-assignment-header-col">
        <label class="ppe-field">
          <span>Номер</span>
          <input name="number" value="@(string.IsNullOrWhiteSpace(doc.Number) ? "<Авто>" : doc.Number)" class="ppe-input" />
        </label>
        <label class="ppe-field">
          <span>от</span>
          <input type="datetime-local" name="date" value="@doc.Date.ToString("yyyy-MM-ddTHH:mm:ss")" class="ppe-input" step="1" />
        </label>
        <label class="ppe-field">
          <span>Подразделение</span>
          <input name="department" value="@doc.Department" class="ppe-input" placeholder="Бухгалтерия" />
        </label>
      </div>
      <div class="sout-assignment-header-col">
        <label class="ppe-field">
          <span>Дата начала</span>
          <input type="date" name="startDate" value="@doc.StartDate?.ToString("yyyy-MM-dd")" class="ppe-input" />
        </label>
        <label class="ppe-field">
          <span>Дата окончания</span>
          <input type="date" name="endDate" value="@doc.EndDate?.ToString("yyyy-MM-dd")" class="ppe-input" />
        </label>
        <label class="ppe-field">
          <span>Организация</span>
          <input name="organization" value="@Model.Organization" class="ppe-input" readonly />
        </label>
        <label class="ppe-field">
          <span>Организация, проводящая оценку</span>
          <input name="assessingOrganization" value="@doc.AssessingOrganization" class="ppe-input" placeholder="ООО «РискКонсалт»" />
        </label>
      </div>
    </div>

    @if (!Model.IsNew)
    {
      var prepIdEsc = Uri.EscapeDataString(doc.Id);
      <div class="sout-preparation-print-links ppe-no-print-block">
        <h3 class="ppe-subtitle">Формы на печать</h3>
        <div class="risks-print-export-list">
          <div class="risks-print-export-row">
            <a class="btn btn-outline btn-sm" asp-page="/Risks/Preparation/Preview" asp-route-id="@doc.Id" asp-route-mode="schedule" target="_blank">График (по месяцам)</a>
            <button type="button" class="btn btn-outline btn-sm" data-risks-export="word" data-risks-export-url="/Risks/Preparation/Preview?id=@prepIdEsc&amp;mode=schedule">Word</button>
          </div>
          <div class="risks-print-export-row">
            <a class="btn btn-outline btn-sm" asp-page="/Risks/Preparation/Preview" asp-route-id="@doc.Id" asp-route-mode="schedule-weekly" target="_blank">График (по неделям)</a>
            <button type="button" class="btn btn-outline btn-sm" data-risks-export="word" data-risks-export-url="/Risks/Preparation/Preview?id=@prepIdEsc&amp;mode=schedule-weekly">Word</button>
          </div>
          <div class="risks-print-export-row">
            <a class="btn btn-outline btn-sm" asp-page="/Risks/Preparation/Preview" asp-route-id="@doc.Id" asp-route-mode="workplaces-list" target="_blank">Перечень рабочих мест</a>
            <button type="button" class="btn btn-outline btn-sm" data-risks-export="word" data-risks-export-url="/Risks/Preparation/Preview?id=@prepIdEsc&amp;mode=workplaces-list">Word</button>
          </div>
          <div class="risks-print-export-row">
            <a class="btn btn-outline btn-sm" asp-page="/Risks/Preparation/Preview" asp-route-id="@doc.Id" asp-route-mode="order" target="_blank">Приказ о комиссии</a>
            <button type="button" class="btn btn-outline btn-sm" data-risks-export="word" data-risks-export-url="/Risks/Preparation/Preview?id=@prepIdEsc&amp;mode=order">Word</button>
          </div>
        </div>
      </div>
    }

    <div class="ppe-actions">
      @if (!Model.IsNew)
      {
        <button type="submit" formaction="?handler=Delete" class="btn btn-outline" onclick="return confirm('Удалить документ?');">Удалить</button>
      }
    </div>
  </form>
</div>

@section Scripts {
  <script src="~/js/risks-doc-export.js" asp-append-version="true"></script>
}
