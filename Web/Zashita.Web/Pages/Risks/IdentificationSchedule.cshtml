@page "/Risks/IdentificationSchedule"
@model Zashita.Web.Pages.Risks.IdentificationScheduleModel
@{
    ViewData["Title"] = "График идентификации опасностей и оценки рисков";
    ViewData["Subtitle"] = Model.Organization;
    var year = Model.ScheduleYear ?? DateTime.Today.Year;
}

<link rel="stylesheet" href="~/css/risks-preparation.css" asp-append-version="true" />

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
  <p class="@(Model.IsError ? "form-error" : "text-success")">@Model.Message</p>
}

<div class="panel ppe-panel">
  <p class="hint" style="margin-top:0">
    <b>Как работать:</b> график собирается из
    <a asp-page="/Risks/Reports/Status">отчёта по рискам</a> или
    <a asp-page="/Risks/AssessmentList">перечня рабочих мест</a> —
    в него попадают подразделения с РМ без оценки, с просроченной оценкой, с истекающим сроком и запланированные на год.
    Нажмите <b>«Сформировать…»</b> → проверьте таблицу по месяцам → <b>Предпечать</b>.
  </p>

  <div class="ppe-toolbar sout-toolbar">
    <form method="post" asp-page="/Risks/IdentificationSchedule" asp-page-handler="FromStatusReport" style="display:inline">
      <input type="hidden" name="scheduleYear" value="@year" />
      <input type="hidden" name="department" value="@Model.Department" />
      <button type="submit" class="btn btn-primary btn-sm" title="Создать график по данным отчёта по рискам">
        Сформировать из отчёта по рискам
      </button>
    </form>
    <form method="post" asp-page="/Risks/IdentificationSchedule" asp-page-handler="FromWorkplaces" style="display:inline">
      <input type="hidden" name="scheduleYear" value="@year" />
      <input type="hidden" name="department" value="@Model.Department" />
      <button type="submit" class="btn btn-outline btn-sm" title="Создать график по перечню рабочих мест">
        Сформировать из перечня РМ
      </button>
    </form>
    <a class="btn btn-outline btn-sm" asp-page="/Risks/Reports/Status">Отчёт по рискам</a>
    <a class="btn btn-outline btn-sm" asp-page="/Risks/AssessmentList">Перечень РМ</a>
    <a class="btn btn-outline btn-sm" asp-page="/Risks/Workplaces">Рабочие места</a>
    @if (!string.IsNullOrWhiteSpace(Model.PrintId))
    {
      <a class="btn btn-outline btn-sm" asp-page="/Risks/Preparation/Edit" asp-route-id="@Model.PrintId">Изменить</a>
      <a class="btn btn-primary btn-sm" asp-page="/Risks/Preparation/Preview" asp-route-id="@Model.PrintId" asp-route-mode="schedule" target="_blank">Предпечать графика</a>
      <button type="button" class="btn btn-outline btn-sm"
              data-risks-export="word"
              data-risks-export-url="/Risks/Preparation/Preview?id=@Uri.EscapeDataString(Model.PrintId)&amp;mode=schedule">Word</button>
    }
  </div>

  <form method="get" class="training-report-filters sout-preparation-filters">
    <input type="hidden" name="printId" id="risks-schedule-print-id" value="@Model.PrintId" />
    <div class="training-planning-filter-grid">
      <label class="training-planning-filter-item">
        <span>Организация</span>
        <input type="text" class="ppe-input" value="@Model.Organization" readonly />
      </label>
      <label class="training-planning-filter-item">
        <span>Год</span>
        <input type="number" name="scheduleYear" value="@Model.ScheduleYear" class="ppe-input" min="2000" max="2100" />
      </label>
      <label class="training-planning-filter-item">
        <span>Подразделение</span>
        <input name="department" value="@Model.Department" class="ppe-input" list="risks-schedule-departments" placeholder="все" autocomplete="off" />
      </label>
      <label class="training-planning-filter-item">
        <span>Поиск</span>
        <input name="q" value="@Model.Q" class="ppe-input" placeholder="номер, сценарий" autocomplete="off" />
      </label>
    </div>
  </form>

  <datalist id="risks-schedule-departments">
    @foreach (var department in Model.Departments)
    {
      <option value="@department"></option>
    }
  </datalist>

  <table class="data-grid sout-preparation-grid" id="risks-schedule-grid">
    <thead>
      <tr>
        <th>Дата</th>
        <th>Номер</th>
        <th>Год</th>
        <th>Источник</th>
        <th>Подразделение</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      @if (Model.Rows.Count == 0)
      {
        <tr><td colspan="6" class="hint">Документов пока нет. Нажмите «Сформировать из отчёта по рискам» или «Сформировать из перечня РМ».</td></tr>
      }
      @foreach (var row in Model.Rows)
      {
        var selected = Model.PrintId == row.Id;
        var rowYear = row.PrintOverrides.TryGetValue("schedule-year", out var y) ? y : (row.StartDate?.Year.ToString() ?? "—");
        var source = row.PrintOverrides.TryGetValue("schedule-source", out var src)
            ? (src == "report" ? "Отчёт по рискам" : src == "workplaces" ? "Перечень РМ" : src)
            : (string.IsNullOrWhiteSpace(row.Scenario) ? "—" : row.Scenario);
        <tr class="sout-preparation-row @(selected ? "training-row-active" : "")" data-id="@row.Id">
          <td>@row.Date.ToString("dd.MM.yyyy")</td>
          <td><a asp-page="/Risks/Preparation/Edit" asp-route-id="@row.Id">@row.Number</a></td>
          <td>@rowYear</td>
          <td>@source</td>
          <td>@(string.IsNullOrWhiteSpace(row.Department) ? "все" : row.Department)</td>
          <td class="ppe-actions-cell">
            <a class="btn btn-outline btn-sm" asp-page="/Risks/Preparation/Preview" asp-route-id="@row.Id" asp-route-mode="schedule" target="_blank">Предпечать</a>
            <form method="post" asp-page="/Risks/IdentificationSchedule" asp-page-handler="Delete" style="display:inline">
              <input type="hidden" name="id" value="@row.Id" />
              <input type="hidden" name="scheduleYear" value="@Model.ScheduleYear" />
              <input type="hidden" name="department" value="@Model.Department" />
              <input type="hidden" name="q" value="@Model.Q" />
              <input type="hidden" name="printId" value="@Model.PrintId" />
              <button type="submit" class="btn btn-outline btn-sm btn-danger" title="Удалить">Удалить</button>
            </form>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>

@section Scripts {
  <script src="~/js/risks-doc-export.js" asp-append-version="true"></script>
  <script>
    (function () {
      var grid = document.getElementById('risks-schedule-grid');
      var printId = document.getElementById('risks-schedule-print-id');
      if (!grid || !printId) return;
      grid.querySelectorAll('tr[data-id]').forEach(function (row) {
        row.addEventListener('click', function (e) {
          if (e.target.closest('a, button, form, input')) return;
          printId.value = row.getAttribute('data-id') || '';
          var url = '/Risks/IdentificationSchedule?printId=' + encodeURIComponent(printId.value);
          var year = document.querySelector('input[name="scheduleYear"]');
          var dept = document.querySelector('input[name="department"]');
          var q = document.querySelector('input[name="q"]');
          if (year && year.value) url += '&scheduleYear=' + encodeURIComponent(year.value);
          if (dept && dept.value) url += '&department=' + encodeURIComponent(dept.value);
          if (q && q.value) url += '&q=' + encodeURIComponent(q.value);
          window.location.href = url;
        });
      });
    })();
  </script>
}
