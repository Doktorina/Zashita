@page "/Sout/Planned"
@model Zashita.Web.Pages.Sout.PlannedModel
@{
    ViewData["Title"] = "Годовой план по специальной оценке";
    ViewData["Subtitle"] = Model.Organization;
    var year = Model.PlanYear ?? DateTime.Today.Year;
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
  <p class="@(Model.IsError ? "form-error" : "text-success")">@Model.Message</p>
}

<div class="panel ppe-panel">
  <p class="hint" style="margin-top:0">
    <b>Как работать:</b> план собирается из <a asp-page="/Sout/Status">отчёта по СОУТ</a> —
    в него попадают рабочие места без актуальной СОУТ, с внеплановой оценкой и те, у кого срок очередной СОУТ приходится на выбранный год.
    Нажмите <b>«Сформировать из отчёта СОУТ»</b> → проверьте расшифровку → <b>Записать</b> / <b>Предпечать</b>.
  </p>

  <div class="ppe-toolbar sout-toolbar">
    <form method="post" asp-page="/Sout/Planned" asp-page-handler="FromStatusReport" style="display:inline">
      <input type="hidden" name="planYear" value="@year" />
      <input type="hidden" name="department" value="@Model.Department" />
      <button type="submit" class="btn btn-primary btn-sm" title="Создать план по данным отчёта по СОУТ">
        Сформировать из отчёта СОУТ
      </button>
    </form>
    <a class="btn btn-outline btn-sm" asp-page="/Sout/Planned/Edit" asp-route-planYear="@year" title="Пустой документ с автозаполнением из отчёта">Создать вручную</a>
    <a class="btn btn-outline btn-sm" asp-page="/Sout/Status">Отчёт по СОУТ</a>
    <a class="btn btn-outline btn-sm" asp-page="/Sout/Workplaces">Рабочие места</a>
  </div>

  <form method="get" class="training-report-filters sout-preparation-filters">
    <div class="training-planning-filter-grid">
      <label class="training-planning-filter-item">
        <span>Организация</span>
        <input type="text" class="ppe-input" value="@Model.Organization" readonly />
      </label>
      <label class="training-planning-filter-item">
        <span>Год</span>
        <input type="number" name="planYear" value="@Model.PlanYear" class="ppe-input" min="2000" max="2100" />
      </label>
      <label class="training-planning-filter-item">
        <span>Подразделение</span>
        <input name="department" value="@Model.Department" class="ppe-input" list="sout-planned-departments" placeholder="все" autocomplete="off" />
      </label>
      <label class="training-planning-filter-item">
        <span>Поиск</span>
        <input name="q" value="@Model.Q" class="ppe-input" placeholder="номер, сценарий, подразделение" autocomplete="off" />
      </label>
    </div>
  </form>

  <datalist id="sout-planned-departments">
    @foreach (var department in Model.Departments)
    {
      <option value="@department"></option>
    }
  </datalist>

  <table class="data-grid sout-preparation-grid">
    <thead>
      <tr>
        <th>Дата</th>
        <th>Номер</th>
        <th>Вид плана</th>
        <th>Сценарий</th>
        <th>Строк РМ</th>
        <th>Статус</th>
        <th>Подразделение</th>
        <th>Организация</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      @if (Model.Rows.Count == 0)
      {
        <tr>
          <td colspan="9" class="hint">
            Планов пока нет. Укажите год (и при необходимости подразделение), затем нажмите
            «Сформировать из отчёта СОУТ».
          </td>
        </tr>
      }
      @foreach (var row in Model.Rows)
      {
        <tr>
          <td>@row.Date.ToString("dd.MM.yyyy")</td>
          <td><a asp-page="/Sout/Planned/Edit" asp-route-id="@row.Id">@row.Number</a></td>
          <td>@row.PlanType</td>
          <td>@row.Scenario</td>
          <td>@row.DetailRows.Count</td>
          <td>@(row.IsPosted ? "Утверждён" : row.Status)</td>
          <td>@(string.IsNullOrWhiteSpace(row.Department) ? "—" : row.Department)</td>
          <td>@row.Organization</td>
          <td style="white-space:nowrap">
            <a class="btn btn-outline btn-sm" asp-page="/Sout/Planned/Edit" asp-route-id="@row.Id">Изменить</a>
            <a class="btn btn-outline btn-sm" asp-page="/Sout/Planned/Preview" asp-route-id="@row.Id" target="_blank">Предпечать</a>
            <form method="post" asp-page-handler="Delete" style="display:inline">
              <input type="hidden" name="id" value="@row.Id" />
              <input type="hidden" name="planYear" value="@Model.PlanYear" />
              <input type="hidden" name="department" value="@Model.Department" />
              <input type="hidden" name="q" value="@Model.Q" />
              <button type="submit" class="btn btn-outline btn-sm" style="color:var(--danger,#c62828)"
                      onclick="return confirm('Удалить план @row.Number?');">Удалить</button>
            </form>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>
