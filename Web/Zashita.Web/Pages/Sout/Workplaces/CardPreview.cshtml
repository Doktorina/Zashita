@page "/Sout/Workplaces/CardPreview"
@model Zashita.Web.Pages.Sout.Workplaces.CardPreviewModel
@{
    Layout = null;
    ViewData["Title"] = Model.NotFound ? "Карта СОУТ" : $"Предпросмотр: карта СОУТ № {Model.CardNumber}";
}

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"]</title>
    <partial name="_SiteIconLinks" />
<style>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background: #c5c5c5; font-family: "Times New Roman", Times, serif; color: #000; }
    .sout-preview-toolbar {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 8px 12px; background: #ece9d8; border-bottom: 1px solid #a0a0a0;
      font-family: "Segoe UI", Tahoma, sans-serif; position: sticky; top: 0; z-index: 20;
    }
    .sout-preview-toolbar-left { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .btn {
      display: inline-block; padding: 6px 12px; border: 1px solid #888; background: #fff;
      cursor: pointer; text-decoration: none; color: #222; font-size: 13px; border-radius: 3px;
    }
    .btn-primary { background: #2f6b3a; color: #fff; border-color: #245530; }
    .hint { font-size: 12px; color: #444; }
    .sout-preview-stage { padding: 20px; overflow: auto; }
    .sout-a4-page {
      background: #fff; margin: 0 auto 24px; box-shadow: 0 2px 14px rgba(0,0,0,.25);
      width: 210mm; min-height: 297mm; padding: 16mm 18mm; color: #000;
    }
    .sout-official-title { text-align: center; font-size: 16pt; font-weight: bold; margin-bottom: 14px; }
    .sout-official-line { text-align: center; font-size: 13pt; }
    .sout-official-caption { text-align: center; font-size: 10pt; margin-bottom: 12px; }
    .sout-official-field, .sout-official-row { margin: 8px 0; font-size: 12pt; }
    .sout-official-table { width: 100%; border-collapse: collapse; margin: 8px 0 12px; font-size: 11pt; }
    .sout-official-table td { border: 1px solid #000; padding: 4px 6px; }
    .sout-official-table td.c { text-align: center; width: 4rem; }
    .sout-official-table td.muted { color: #555; font-style: italic; }
    .sout-card-snils-box { border: 1px solid #000; display: inline-block; min-width: 12rem; padding: 4px 10px; margin: 4px 8px 10px 0; }
    .sout-official-date { margin-top: 24px; font-size: 12pt; }
    .muted { color: #444; font-size: 10pt; }
    .sout-preview-missing { padding: 24px; font-family: "Segoe UI", Tahoma, sans-serif; }
    @@media print {
      html, body { background: #fff; }
      .sout-preview-toolbar { display: none !important; }
      .sout-preview-stage { padding: 0; }
      .sout-a4-page { box-shadow: none; margin: 0; width: auto; min-height: auto; padding: 0; }
    }
  </style>
</head>
<body>
@if (Model.NotFound)
{
  <div class="sout-preview-missing">
    <p>Карта не найдена.</p>
    <a class="btn" href="/Sout/Workplaces?view=cards">К списку карт СОУТ</a>
  </div>
}
else
{
  <div class="sout-preview-toolbar">
    <div class="sout-preview-toolbar-left">
      <button type="button" class="btn btn-primary" onclick="window.print()">Печать</button>
      <a class="btn" href="/Sout/Workplaces/Card?id=@Uri.EscapeDataString(Model.Id)">Редактировать</a>
      <a class="btn" href="/Sout/Workplaces?view=cards">К списку</a>
    </div>
    <span class="hint">@Model.Organization</span>
  </div>
  <div class="sout-preview-stage">
    <div class="sout-a4-page">
      @Html.Raw(Model.PreviewHtml)
    </div>
  </div>
}
</body>
</html>
